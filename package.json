{
  "name": "zentrix-index",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n vite,server -c blue,green \"vite\" \"node server/index.js\"",
    "dev:local": "concurrently -n vite,server -c blue,green \"vite\" \"node server/local-dev.mjs\"",
    "dev:frontend": "vite",
    "dev:server": "node server/index.js",
    "build": "vite build",
    "check:syntax": "node scripts/check-syntax.mjs",
    "test": "node --test",
    "check": "npm run check:syntax && npm test && npm run build",
    "build:firestone-exporter": "pkg tools/firestone-collection-exporter/export-firestone-collection.cjs --targets node18-win-x64 --output tools/firestone-collection-exporter/Firestone收藏导出工具.exe",
    "refresh:hearthstone-cards": "node scripts/fetch-hsjson-cards.mjs",
    "generate:achievement-card-manifest": "node scripts/generate-achievement-card-manifest.mjs",
    "preview": "vite preview",
    "server": "node server/index.js",
    "start": "NODE_ENV=production node server/index.js",
    "upload:oss": "node scripts/upload-to-oss.mjs",
    "upload:oss:related": "node scripts/upload-to-oss.mjs related",
    "download:hearthstone-coins": "node scripts/download-hs-coins.mjs",
    "download:hearthstone-hero-skins": "node scripts/download-hs-hero-skins.mjs",
    "download:hearthstone-card-backs": "node scripts/download-hs-card-backs.mjs",
    "extract:hearthstone-card-backs": "node scripts/extract-hs-card-backs-from-client.mjs",
    "extract:hearthstone-hero-details": "node scripts/extract-hs-hero-details-from-client.mjs",
    "extract:hearthstone-coin-names": "node scripts/extract-hs-coin-names-from-client.mjs",
    "check:hearthstone-cosmetics": "node scripts/check-hs-cosmetics.mjs",
    "sync:hearthstone-cosmetics": "node scripts/sync-hs-cosmetics-manifest.mjs",
    "download:hearthstone-cosmetics": "npm run download:hearthstone-coins && npm run download:hearthstone-hero-skins && npm run download:hearthstone-card-backs",
    "upload:oss:cosmetics": "node scripts/upload-hs-cosmetics-to-oss.mjs",
    "upload:oss:card-backs": "node scripts/upload-hs-card-backs-to-oss.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "echarts": "^5.6.0",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.0",
    "html-to-image": "^1.11.13",
    "ip2region": "^2.3.0",
    "jsonwebtoken": "^9.0.3",
    "markdown-it": "^14.3.0",
    "nodemailer": "^6.10.1",
    "pg": "^8.22.0",
    "vue": "^3.4.0",
    "vue-router": "^4.2.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.7",
    "ali-oss": "^6.23.0",
    "better-sqlite3": "^12.11.1",
    "classic-level": "^3.0.0",
    "concurrently": "^10.0.3",
    "pkg": "^5.8.1",
    "vite": "^8.0.16"
  }
}
