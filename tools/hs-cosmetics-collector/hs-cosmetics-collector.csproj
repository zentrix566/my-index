<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinExe：双击运行不再弹出黑色控制台窗口，界面为 WinForms 图形程序 -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <!-- 必须 x64：炉石传说是 64 位进程，32 位宿主无法枚举/读取其模块
         （UnitySpy 报 "Failed to read modules from the external process"）。
         UnitySpy.HearthstoneLib 是托管 AnyCPU，可正常加载进 64 位宿主。 -->
    <PlatformTarget>x64</PlatformTarget>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>HsCosmeticsCollector</AssemblyName>
    <RootNamespace>HsCosmeticsCollector</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <SelfContained>false</SelfContained>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- 完整的版本信息资源（文件属性 / 杀软启发式信誉评估的正向信号） -->
    <AssemblyTitle>炉石收藏与成就采集器</AssemblyTitle>
    <Product>炉石收藏与成就采集器</Product>
    <Company>zentrix566</Company>
    <Description>读取炉石传说游戏内存，导出已拥有的卡背、幸运币、英雄皮肤与成就进度 JSON，供网站收藏页/成就页导入。</Description>
    <Copyright>Copyright © 2026 zentrix566</Copyright>
    <NeutralLanguage>zh-CN</NeutralLanguage>
    <!-- 发布版本号；build-release.ps1 会读取此值并生成 hs-cosmetics-collector-v{Version}.zip -->
    <Version>1.3.1</Version>
    <AssemblyVersion>1.3.1.0</AssemblyVersion>
    <FileVersion>1.3.1.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- 仅用于编译期解析 .NET Framework 4.8 引用程序集；UnitySpy 在运行时通过 lib/ 加载，无需编译期引用 -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
    <!-- net48 不含 System.Text.Json，显式引入（netstandard2.0 目标，兼容） -->
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <ItemGroup>
    <!-- 运行时加载的炉石内存读取库（来自 Firestone 插件目录，已复制到 lib/） -->
    <None Include="lib\UnitySpy.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="lib\UnitySpy.HearthstoneLib.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
