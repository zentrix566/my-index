# Node.js 运行环境（development / production）
NODE_ENV=development

# 仅供本地登录和进度验证；true 时使用 SQLite，不连接 PostgreSQL
LOCAL_DEV_MODE=false
# 业务库本地 SQLite 文件路径（炉石进度、AI 额度等，默认 ./data/app.local.db）
LOCAL_SQLITE_PATH=./data/app.local.db
# 认证库本地 SQLite 文件路径（用户、令牌、模块使用记录，默认 ./data/auth.local.db）
AUTH_LOCAL_SQLITE_PATH=./data/auth.local.db

# 服务端口
PORT=3000

# 访问日志存储目录（默认 ./logs）
LOG_DIR=./logs

# JWT 签名密钥；生产环境必须替换为随机长字符串
JWT_SECRET=your-random-jwt-secret-here

# PostgreSQL 业务库连接配置（炉石进度、个人配置、AI 额度）
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=postgres
PG_DATABASE=zentrix
PG_PASS=your-postgresql-password-here
PG_SSL=false

# 统一认证库（users / 令牌 / 模块使用记录）独立连接串。
# 配置后账号体系与业务数据物理隔离，业务表只保留 user_id 普通列、不建跨库外键。
# 留空则回退到上面的 PG_* 主库（迁移过渡期兼容，行为与拆库前一致）。
# 格式：postgres://用户:密码@主机:端口/zentrix_auth
AUTH_DB_URL=

# 「抵御心魔」独立数据层配置（独立库，与炉石 zentrix 库隔离）
# 生产连独立的 PostgreSQL 库；未单独配置时回退到上面的 PG_* 同名项，仅库名固定为 zentrix_willpower
WILLPOWER_PG_HOST=127.0.0.1
WILLPOWER_PG_PORT=5432
WILLPOWER_PG_USER=postgres
WILLPOWER_PG_DATABASE=zentrix_willpower
WILLPOWER_PG_PASS=your-postgresql-password-here
WILLPOWER_PG_SSL=false
# 本地开发（LOCAL_DEV_MODE=true）使用独立 SQLite 文件，不连 PG
WILLPOWER_LOCAL_SQLITE_PATH=./data/willpower.local.db
# 计时挑战默认坚持时长（秒），满即判抵御成功；默认 600（10 分钟）
WILLPOWER_HOLD_SECONDS=600
# 统计「今天 / 凌晨」所用的时区，默认 Asia/Shanghai
WILLPOWER_TIME_ZONE=Asia/Shanghai
# AI 报告每日额度（可选，默认 5 次/天）；密钥复用上面的 DEEPSEEK_API_KEY
WILLPOWER_AI_DAILY=5

# 首次启动时创建所有者账号并导入示例进度
SEED_ON_STARTUP=false
OWNER_USERNAME=owner
OWNER_PASSWORD=your-owner-password-here

# AI 建议（实验功能）：DeepSeek Key 仅服务端使用，前端不接触
# 地址/模型固定为 https://api.deepseek.com/v1 + deepseek-v4-flash，无需配置
DEEPSEEK_API_KEY=your-deepseek-api-key-here
# 每日额度（可选，默认 5 次固定问答 + 1 次自由提问）
AI_FIXED_DAILY=5
AI_FREE_DAILY=1
# 每日额度重置时区（IANA 时区名）
AI_QUOTA_TIME_ZONE=Asia/Hong_Kong
# 「黄粱一梦」人生模拟器使用的 DeepSeek 模型（可选，默认 deepseek-chat）；
# 接口基地址（可选，默认 https://api.deepseek.com），与上方 Key 一起经服务端 /api/dream 代理，前端不接触。
DEEPSEEK_DREAM_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 炉石卡牌图（卡组详情）前端基地址。
# 留空（推荐）：前端用相对路径 /hearthstone-cards/...，图片以本站域名开头，
#   由服务端 /hearthstone-cards/* 反向代理到下方 OSS_ORIGIN（无需给 OSS 绑自定义域名/备案）。
# 也可填一个已备案的绝对地址（如 https://cdn.example.com），前端将直连该地址（不带结尾斜杠）。
VITE_OSS_BASE=

# 服务端反向代理的真实 OSS 源站（公开读）。/hearthstone-cards/* 的请求会被代理到这里，
# 并强制以 inline 方式返回图片（右键「在新标签打开图片」直接查看而非下载）。
# 格式：https://<bucket>.oss-cn-<真实region>.aliyuncs.com  （例如 beijing，务必替换占位符，不带结尾斜杠）
OSS_ORIGIN=https://your-bucket.oss-cn-beijing.aliyuncs.com

# OSS 上传脚本配置（仅维护图片/站点资源时使用）
OSS_BUCKET=your-oss-bucket
OSS_REGION=cn-beijing
OSS_ACCESS_KEY_ID=your-oss-access-key-id
OSS_ACCESS_KEY_SECRET=your-oss-access-key-secret
OSS_PREFIX=hearthstone-cards
OSS_SOURCE_DIR=E:/github/my-heartstone/hearthstone_cards
OSS_USE_MANIFEST=1
OSS_SKIP_EXISTING=1
OSS_CHECK_CONCURRENCY=20
OSS_DRY_RUN=0

# 炉石数据维护脚本配置（仅重新生成卡名或图片清单时使用）
HS_CARDS_FILE=
CARD_IMG_SOURCE=E:/github/my-heartstone/hearthstone_cards/wild

# SQLite 数据导出/迁移脚本配置
SQLITE_PATH=./data/app.db
OUT_DIR=./data

# 「忘记密码」/「邮箱激活」发信配置（SMTP）。全部留空则降级为控制台打印链接，便于本地测试。
# 可选服务商：QQ 邮箱（smtp.qq.com:465 隐式 TLS，SMTP_PASS 填「授权码」而非登录密码）、
#   Gmail SMTP（smtp.gmail.com:587，需「应用专用密码」）、SendGrid、阿里云邮件推送等。
SMTP_HOST=
SMTP_PORT=465
# 设为 true 表示使用 465 隐式 TLS（如用 465 端口）；587 走 STARTTLS 留空即可
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# 发件人显示，QQ 邮箱通常填写与 SMTP_USER 相同的地址
SMTP_FROM=your-qq-number@qq.com

# 重置链接前端域名（用户点邮件里的链接打开的页面地址）。
# 生产填 https://zentrix566.top，本地开发填 http://localhost:5173
APP_URL=http://localhost:5173
