# 所有以点(.)开头的目录都不提交（隐藏目录，如 .workbuddy/.vscode/.idea/.zcode/.build-tmp 等）
# 注：.git 目录由 git 自身管理，不受此规则影响；.github 必须提交以启用 CI。
**/.*/
!.github/
# 验证构建散文件（vite build --outDir .build-* 产物及冒烟测试抓取的响应），均不提交
.build-*

# 临时调试产物目录（Playwright 截图、生成的中间图片等），不提交
outputs/

# DevOps Actions directory
devops-actions/

# Node.js
node_modules/
dist/
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 环境变量（含密钥，绝不入库；仅 .env.example 可跟踪）
.env
.env.*
!.env.example

# Docker
*.tar
*.log

# IDE
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# ZCode local config
k8s/cloudflared-deployment.yaml

# 构建中间产物（验证用，可手动删除）
dist-old/

# 炉石卡牌图片由阿里云 OSS 托管；若临时生成到功能目录，不进入版本库。
src/features/hearthstone/assets/cards/

# SQLite 数据库（运行时数据，不入库；种子文件 server/seed/ 保留跟踪）
data/app.db
data/app.db-wal
data/app.db-shm
data/app.local.db
data/app.local.db-wal
data/app.local.db-shm
# 「抵御心魔」独立 SQLite 运行时库，不入库（含用户记录）
data/willpower.local.db
data/willpower.local.db-wal
data/willpower.local.db-shm
# 本地用户注册产生的认证库，不入库（含账号记录）
data/auth.local.db
data/auth.local.db-wal
data/auth.local.db-shm
# 日程管理独立 SQLite 运行时库，不入库（含用户任务记录）
data/todo.local.db
data/todo.local.db-wal
data/todo.local.db-shm
# 本地数据迁移备份可能包含账号、邮箱和业务记录，整目录不入库
data/backups/
server/seed/*.local.json

# 数据库导出中间产物（含用户密码哈希等敏感数据，绝不入库）
server/remote-data/

# Windows 保留设备名误生成的垃圾文件，永不入库
nul

# AI 临时工具脚本（单下划线前缀，如 _audit_ach_updates.mjs），不入库；正式脚本（generate-*/audit-*/upload-* 等）保持跟踪
scripts/_*.mjs

# 炉石卡牌图库旧管线脚本（已被 fetch-hs-cards.mjs / upload-hs-cards-to-oss.mjs 取代），不入库
scripts/analyze-hs-dupes.mjs
scripts/fetch-card-images.mjs

# 炉石外观采集工具（C# 项目）编译产物与第三方 DLL，不入库
tools/hs-cosmetics-collector/bin/
tools/hs-cosmetics-collector/obj/
tools/hs-cosmetics-collector/dist/
tools/hs-cosmetics-collector/lib/
# build-release.ps1 的 Roslyn 编译器缓存与运行时依赖提取目录
tools/hs-cosmetics-collector/.build/

# 炉石外观分发包（含 exe/dll），不入库
tools/hs-cosmetics-dist/
tools/hs-cosmetics-dist.zip

# 导入器构建产物（由 build-importer.mjs 生成），不入库
tools/hs-cosmetics-viewer/dist-importer/

# 采集器写入的个人游戏数据（含已拥有外观/成就），绝不入库
tools/hs-cosmetics-viewer/data/
tools/hs-cosmetics-viewer/owned-with-names.md

# 带日期的一次性上传脚本，不入库
scripts/upload-card-backs-20*.mjs
